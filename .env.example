# Intellihunt Environment Configuration
# Fill in your MongoDB Atlas connection string below

# MongoDB Atlas connection string
MONGO_URL=
MONGO_DB=intellihunt

# Threat Intelligence API Keys (optional)
VT_API_KEY=
ABUSE_IPDB_KEY=

# ─── Alerting: Gmail SMTP (use App Password) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ─── Alerting: Slack Incoming Webhook ───────────────────────
SLACK_WEBHOOK_URL=

# ─── Alerting: Microsoft Teams Incoming Webhook ────────────
TEAMS_WEBHOOK_URL=

# ─── AI Copilot: Grok API Key (xAI) ───────────────────────
# Get a key at https://console.x.ai
GROK_API_KEY=
